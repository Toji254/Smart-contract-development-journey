# Safe defaults. These settings are not a production deployment configuration.
MARKTRAIL_HOST=127.0.0.1
MARKTRAIL_PORT=8000
MARKTRAIL_DB_PATH=

# Demo users are disabled by default.
MARKTRAIL_SEED_DEMO=0

# Session cookies require HTTPS by default. Set to 0 only for local HTTP.
MARKTRAIL_COOKIE_SECURE=1

# off = no real blockchain transaction
# cast = use Foundry's cast against an EVM RPC
MARKTRAIL_CHAIN_MODE=off
MARKTRAIL_CHAIN_RPC=http://127.0.0.1:8545
MARKTRAIL_CONTRACT=
MARKTRAIL_CHAIN_PRIVATE_KEY=
