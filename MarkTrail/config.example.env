# MarkTrail configuration
# Copy this file to .env and adjust for your deployment.
# Load with: export $(grep -v '^#' .env | xargs)

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Path to the SQLite database file.
# Default: data/marktrail.db (relative to project root)
# MARKTRAIL_DB_PATH=data/marktrail.db

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
# Bind address. Use 0.0.0.0 to accept connections from other machines.
# Default: 127.0.0.1 (localhost only)
MARKTRAIL_HOST=127.0.0.1

# Port to listen on.
# Default: 8000
MARKTRAIL_PORT=8000

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
# Set to 1 for HTTPS deployments (production).
# Set to 0 for local HTTP development only.
# Default: 1
MARKTRAIL_COOKIE_SECURE=0

# ─────────────────────────────────────────────
# Demo data
# ─────────────────────────────────────────────
# Set to 1 to seed demo accounts and sample data on startup.
# NEVER enable in production — demo passwords are public.
# Default: 0
MARKTRAIL_SEED_DEMO=0

# ─────────────────────────────────────────────
# Blockchain integration (optional)
# ─────────────────────────────────────────────
# Leave all MARKTRAIL_CHAIN_* variables unset to run in
# local-only audit mode. The system works fully without a chain.
# Blockchain adds tamper-evident commitments on top of the DB audit trail.

# Chain mode: "cast" (Foundry) or "off"
# MARKTRAIL_CHAIN_MODE=cast

# RPC URL for your EVM-compatible node (Anvil, Hardhat, or testnet)
# MARKTRAIL_CHAIN_RPC=http://127.0.0.1:8545

# Deployed MarkTrailAudit contract address
# MARKTRAIL_CONTRACT=0x...

# Private key for the lecturer signer wallet (0x-prefixed)
# MARKTRAIL_CHAIN_PRIVATE_KEY=0x...

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
# Set to 1 to suppress per-request HTTP logs.
# Default: 0
# MARKTRAIL_QUIET=0
