          "partialFingerprints": {
            "id": "3f3e25ecd3b9d090fd8cc6c3f9120d1e2c33537dbefebcf6022b11e920cc1711"
          }
        },
        {
          "ruleId": "3-0-low-level-calls",
          "message": {
            "text": "Low level call in Tipjar.withdraw(address,uint256) (src/Tipjar2.sol#15-22):\n\t- (success,None) = address(to).call{value: amount}() (src/Tipjar2.sol#18)\n",
            "markdown": "Low level call in [Tipjar.withdraw(address,uint256)](src/Tipjar2.sol#L15-L22):\n\t- [(success,None) = address(to).call{value: amount}()](src/Tipjar2.sol#L18)\n"
          },
          "level": "warning",
          "locations": [
